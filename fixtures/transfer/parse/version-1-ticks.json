{
  "description": "A version 1 file, from before marks had kinds, still imports: each true day reads as great and each false one as empty.",
  "input": {
    "format": "fitness-planner-export",
    "version": 1,
    "exercise": {
      "plans": { "2026-10-19": [{ "id": "pu", "name": "Push-ups", "reps": 10, "target": 4 }] },
      "log": { "2026-10-19": { "pu": [true, false, true, false, false, true, false] } }
    },
    "diet": {
      "plans": { "2026-10-19": [{ "id": "veg", "name": "Vegetables", "target": 7 }] },
      "log": { "2026-10-19": { "veg": [false, false, false, false, false, false, true] } }
    }
  },
  "expected": {
    "ok": true,
    "data": {
      "exercise": {
        "plans": { "2026-10-19": [{ "id": "pu", "name": "Push-ups", "reps": 10, "target": 4 }] },
        "log": { "2026-10-19": { "pu": ["great", null, "great", null, null, "great", null] } }
      },
      "diet": {
        "plans": { "2026-10-19": [{ "id": "veg", "name": "Vegetables", "target": 7 }] },
        "log": { "2026-10-19": { "veg": [null, null, null, null, null, null, "great"] } }
      },
      "settings": null
    }
  }
}
